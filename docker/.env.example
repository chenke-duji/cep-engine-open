# ============================================================
# CEP Event Engine - Docker Environment Variables
# Copy to .env and edit before running docker compose.
#   cp .env.example .env
#   docker compose up -d
# ============================================================

# ---- MongoDB ----
MONGO_ROOT_USER=cep
MONGO_ROOT_PASSWORD=change-me-to-a-strong-password

# ---- CEP Engine Security ----
# JWT secret (>= 32 chars). Generate: openssl rand -hex 32
CEP_JWT_SECRET=change-this-to-a-random-32-char-secret
# Bootstrap admin credentials (password empty = auto-generated on first start)
CEP_ADMIN_USER=admin
CEP_ADMIN_PASSWORD=

# ---- Optional: prometheus-webhook ----
# Uncomment when enabling the prometheus-webhook service
# WEBHOOK_AUTH_TOKEN=generate-with-openssl-rand-hex-32
